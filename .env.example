# Perfil activo
SPRING_PROFILES_ACTIVE=dev

# Configuracion de base de datos
DB_HOST=localhost
DB_PORT=5432
DB_NAME=atleta_dev
DB_USERNAME=atleta_dev
DB_PASSWORD=change-me-local-password

# Cuentas locales reproducibles para probar la aplicacion (solo perfil dev).
# Cambia esta clave en tu .env local; nunca la uses fuera de desarrollo.
DEV_SEED_ENABLED=true
DEV_SEED_PASSWORD=AtletaDev!2026

# Configuracion JWT
# Recomendado: usar Base64 o una cadena de 32+ bytes.
JWT_SECRET=replace-with-a-secure-secret-of-at-least-32-bytes
JWT_ISSUER=atleta-dev
JWT_EXPIRATION=PT1H

# Google OAuth2
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Servidor
SERVER_PORT=8080

# Scheduler de estados de partido
MATCH_STATUS_SCHEDULER_ENABLED=true
MATCH_STATUS_SCHEDULER_INITIAL_DELAY=PT1M
MATCH_STATUS_SCHEDULER_FIXED_DELAY=PT5M

# CORS
# En staging/prod usa dominios explicitos separados por coma.
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:8100,http://localhost:4200,http://localhost:4201,http://localhost:3000
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,Accept,Origin,X-Requested-With,Idempotency-Key
CORS_EXPOSED_HEADERS=Authorization
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=3600

# Flyway
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=false
FLYWAY_CLEAN_DISABLED=true

# SSL de PostgreSQL (produccion)
# SSL_CERT_PATH=/path/to/client-cert.pem
# SSL_KEY_PATH=/path/to/client-key.pem
# SSL_ROOT_CERT_PATH=/path/to/root-ca.pem
# SSL_PASSWORD=change-me
