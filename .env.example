# Configuracion de Base de Datos
DB_HOST=localhost
DB_PORT=5432
DB_NAME=atleta_dev
DB_USERNAME=postgres
DB_PASSWORD=12345

# Configuracion de Google OAuth2
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Configuracion JWT
# Recomendado: usar un valor Base64 o una cadena de 32+ bytes
JWT_SECRET=replace-with-a-secure-secret-of-at-least-32-bytes
JWT_ISSUER=atleta-dev
JWT_EXPIRATION=PT1H

# Configuracion de Servidor
SERVER_PORT=8080

# Configuracion de SSL (solo produccion)
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem
# SSL_ROOT_CERT_PATH=/path/to/root-cert.pem
# SSL_PASSWORD=your-ssl-password
