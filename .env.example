# Configuración de Base de Datos
DB_HOST=localhost
DB_PORT=5432
DB_NAME=atleta_dev
DB_USERNAME=postgres
DB_PASSWORD=12345

# Configuración de Google OAuth2
# Obtener de: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Configuración de Servidor
SERVER_PORT=8080

# Configuración de SSL (solo producción)
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem
# SSL_ROOT_CERT_PATH=/path/to/root-cert.pem
# SSL_PASSWORD=your-ssl-password

# Configuración de OAuth2 Resource Server (solo producción)
# OAUTH2_ISSUER_URI=https://your-auth-server.com
